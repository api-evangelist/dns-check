          "name": "Get DNS record monitoring status",
          "request": {
            "name": "Get DNS record monitoring status",
            "description": {
              "content": "Returns monitoring data for one record, all records in a group, or all records across all groups. Use `all` for `group_uuid` to query every group, and `all` for `record_id` to query every record in the selected group.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "groups",
                ":group_uuid",
                ":record_id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) 32-character DNS Check API key"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "group_uuid",
                  "description": "(Required) 36-character group UUID, or `all` for every group"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "record_id",
                  "description": "(Required) Integer DNS record ID, or `all` for every record"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
