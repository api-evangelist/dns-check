    "_postman_id": "94d7c3ff-34f1-49cf-b996-ea9f151738a8",
    "name": "DNS Check API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "RESTful JSON API for DNS Check, a domain DNS monitoring service. The API is read-only via HTTP GET and authenticates with a 32-character `api_key` query parameter. It exposes endpoints for DNS record monitoring and DNS record group monitoring across record types A, AAAA, ALIAS, CAA, CNAME, MX, NS, PTR, SOA, SPF, SRV, and TXT.",
